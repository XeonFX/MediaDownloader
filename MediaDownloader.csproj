<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- App version; release builds override this with the git tag (-p:Version=X.Y.Z).
         UpdateService compares it against the latest GitHub release. -->
    <Version>1.0.3</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Native tray callbacks (Objective-C runtime on macOS, Win32 WndProc on Windows) need
         [UnmanagedCallersOnly] function pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project lives in a subfolder of this one; exclude it from the default globs
         so its .cs files (and their own Fact/Theory attributes) aren't compiled twice. -->
    <Compile Remove="MediaDownloader.Tests/**/*.cs" />
    <Content Remove="MediaDownloader.Tests/**/*" />
    <None Remove="MediaDownloader.Tests/**/*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project call the internal HTML-parsing methods on the scraper providers
         directly (fixture-based, no network), instead of only exercising them indirectly through
         the public SearchAsync (which requires a live HTTP call). -->
    <InternalsVisibleTo Include="MediaDownloader.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Menu-bar template icons, loaded at runtime by MacTrayApp. -->
    <Content Include="Assets/MenuBarIcon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/MenuBarIcon@2x.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- System-tray icon, loaded at runtime by WindowsTrayApp. -->
    <Content Include="Assets/TrayIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- UI translations, loaded at runtime by LocalizationService. -->
    <Content Update="Resources/i18n/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.5.2" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MudBlazor" Version="9.4.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
    <!-- Override transitive SQLitePCLRaw 2.1.11 which bundles a vulnerable SQLite (CVE-2025-6965, NU1903) -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- Ships Error+ log events to Sentry when Sentry:Dsn is configured; a no-op otherwise. -->
    <PackageReference Include="Sentry.Serilog" Version="6.6.0" />
  </ItemGroup>

</Project>
