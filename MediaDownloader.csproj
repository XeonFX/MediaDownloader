<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- App version; release builds override this with the git tag (-p:Version=X.Y.Z).
         UpdateService compares it against the latest GitHub release. -->
    <Version>1.0.1</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Objective-C runtime callbacks (menu-bar agent) need [UnmanagedCallersOnly] function pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Menu-bar template icons, loaded at runtime by MacTrayApp. -->
    <Content Include="Assets/MenuBarIcon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/MenuBarIcon@2x.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.4.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
    <!-- Override transitive SQLitePCLRaw 2.1.11 which bundles a vulnerable SQLite (CVE-2025-6965, NU1903) -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
  </ItemGroup>

</Project>
