@inherits LayoutComponentBase
@inject DesktopNotifier DesktopNotifier
@inject IJSRuntime JS
@implements IDisposable

<MudThemeProvider Theme="_theme" IsDarkMode="_isDarkMode"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar Elevation="0" Dense="false">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)"/>
        <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Class="mr-3" Square="false">
            <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small"/>
        </MudAvatar>
        <MudText Typo="Typo.h6">MediaDownloader</MudText>
        <MudSpacer/>
        <MudTooltip Text="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Rounded.LightMode : Icons.Material.Rounded.DarkMode)"
                           Color="Color.Inherit" OnClick="ToggleThemeAsync"/>
        </MudTooltip>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Width="240px">
        <MudNavMenu Rounded="true" Margin="Margin.Normal" Color="Color.Primary" Class="pa-3">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Rounded.Download">Downloads</MudNavLink>
            <MudNavLink Href="/search" Icon="@Icons.Material.Rounded.Search">Search</MudNavLink>
            <MudNavLink Href="/series" Icon="@Icons.Material.Rounded.LiveTv">Series Tasks</MudNavLink>
            <MudNavLink Href="/settings" Icon="@Icons.Material.Rounded.Settings">Settings</MudNavLink>
        </MudNavMenu>
        <MudSpacer/>
        <MudText Typo="Typo.caption" Align="Align.Center" Class="mud-text-secondary pb-4">
            MediaDownloader v@(UpdateService.CurrentVersionText)
        </MudText>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = true;

    private static readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#6366F1",
            PrimaryContrastText = "#FFFFFF",
            Secondary = "#0EA5E9",
            Background = "#F6F7FB",
            Surface = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#1E293B",
            DrawerBackground = "#F6F7FB",
            DrawerText = "#334155",
            DrawerIcon = "#64748B",
            TextPrimary = "#1E293B",
            TextSecondary = "#64748B",
            ActionDefault = "#64748B",
            Divider = "#E2E8F0",
            LinesDefault = "#E2E8F0",
            TableLines = "#EDF0F5",
            Success = "#16A34A",
            Info = "#0284C7",
            Warning = "#D97706",
            Error = "#DC2626",
            HoverOpacity = 0.04
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#818CF8",
            PrimaryContrastText = "#0B0D12",
            Secondary = "#38BDF8",
            Background = "#0F1117",
            Surface = "#171A21",
            AppbarBackground = "#0F1117",
            AppbarText = "#E2E8F0",
            DrawerBackground = "#0F1117",
            DrawerText = "#CBD5E1",
            DrawerIcon = "#94A3B8",
            TextPrimary = "#E2E8F0",
            TextSecondary = "#94A3B8",
            ActionDefault = "#94A3B8",
            Divider = "#252A33",
            LinesDefault = "#252A33",
            TableLines = "#222731",
            Success = "#4ADE80",
            Info = "#38BDF8",
            Warning = "#FBBF24",
            Error = "#F87171",
            HoverOpacity = 0.06
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "10px",
            AppbarHeight = "64px"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = new[] { "Inter", "Segoe UI", "Roboto", "Helvetica", "Arial", "sans-serif" }
            },
            H4 = new H4Typography { FontWeight = "700", FontSize = "1.9rem" },
            H5 = new H5Typography { FontWeight = "600" },
            H6 = new H6Typography { FontWeight = "600", FontSize = "1.1rem" },
            Button = new ButtonTypography { FontWeight = "600", TextTransform = "none" }
        }
    };

    protected override void OnInitialized()
    {
        DesktopNotifier.Notified += OnDesktopNotification;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var stored = await JS.InvokeAsync<string?>("mediaDownloader.getTheme");
            _isDarkMode = stored is null
                ? await JS.InvokeAsync<bool>("mediaDownloader.prefersDark")
                : stored == "dark";
            StateHasChanged();

            await JS.InvokeVoidAsync("mediaDownloader.requestNotificationPermission");
        }
    }

    private async Task ToggleThemeAsync()
    {
        _isDarkMode = !_isDarkMode;
        await JS.InvokeVoidAsync("mediaDownloader.setTheme", _isDarkMode ? "dark" : "light");
    }

    private async Task OnDesktopNotification(NotificationEvent evt)
    {
        try
        {
            await JS.InvokeVoidAsync("mediaDownloader.showNotification", evt.Title, evt.Message);
        }
        catch
        {
            // circuit disconnected; ignore
        }
    }

    public void Dispose()
    {
        DesktopNotifier.Notified -= OnDesktopNotification;
    }
}
