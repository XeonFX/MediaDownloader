@page "/search"
@inherits LocalizedComponentBase
@using MediaDownloader.Components.Dialogs
@inject TorrentSearchService SearchService
@inject SearchState State
@inject DownloadManager DownloadManager
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>@L["search.title"]</PageTitle>

<MudStack Spacing="1" Class="mb-6">
    <MudText Typo="Typo.h4">@L["search.title"]</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["search.subtitle"]</MudText>
</MudStack>

<MudPaper Outlined="true" Class="pa-4 mb-4">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="5">
            <MudTextField @bind-Value="_query" Label="@L["search.query"]" Variant="Variant.Outlined"
                          Immediate="true" OnKeyUp="@OnKeyUp" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"/>
        </MudItem>
        <MudItem xs="6" sm="2">
            <MudSelect T="string" @bind-Value="_provider" Label="@L["search.source"]" Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@("")">@L["search.allSources"]</MudSelectItem>
                @foreach (var name in SearchService.ProviderNames)
                {
                    <MudSelectItem T="string" Value="@name">@name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" sm="2">
            <MudSelect T="string" @bind-Value="_resolution" Label="@L["search.resolution"]" Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@("")">@L["search.resolutionAny"]</MudSelectItem>
                @foreach (var res in Resolutions)
                {
                    <MudSelectItem T="string" Value="@res">@res</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="3" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                       DropShadow="false" StartIcon="@Icons.Material.Rounded.Search" Disabled="_searching"
                       OnClick="SearchAsync">
                @(_searching ? L["search.searching"] : L["search.button"])
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_searching)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4"/>
}
@if (_results is null)
{
    <MudPaper Outlined="true" Class="pa-16">
        <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Rounded.TravelExplore" Size="Size.Large" Class="mud-text-secondary"/>
            <MudText Typo="Typo.body1" Class="mud-text-secondary">@L["search.emptyPrompt"]</MudText>
        </MudStack>
    </MudPaper>
}
else
{
    @if (_results.Count == 0)
    {
        @if (!_searching)
        {
        <MudPaper Outlined="true" Class="pa-16">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Rounded.SearchOff" Size="Size.Large" Class="mud-text-secondary"/>
                <MudText Typo="Typo.h6">@L["search.noResults"]</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["search.noResultsHint"]</MudText>
            </MudStack>
        </MudPaper>
        }
    }
    else
    {
        <MudPaper Outlined="true" Class="overflow-hidden">
        <MudTable Items="_results" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Elevation="0">
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<TorrentSearchResult, object>(r => r.Title)">@L["search.colTitle"]</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<TorrentSearchResult, object>(r => r.Source)">@L["search.colSource"]</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<TorrentSearchResult, object>(r => r.SizeBytes)">@L["search.colSize"]</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="new Func<TorrentSearchResult, object>(r => r.Seeders)">@L["search.colSeeds"]</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<TorrentSearchResult, object>(r => r.Leechers)">@L["search.colLeech"]</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<TorrentSearchResult, object>(r => r.PublishedAt ?? DateTime.MinValue)">@L["search.colPublished"]</MudTableSortLabel></MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel='@L["search.colTitle"]'>
                    <MudText Typo="Typo.body2" Style="word-break:break-all">@context.Title</MudText>
                </MudTd>
                <MudTd DataLabel='@L["search.colSource"]'>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary">@context.Source</MudChip>
                </MudTd>
                <MudTd DataLabel='@L["search.colSize"]'>@context.SizeDisplay</MudTd>
                <MudTd DataLabel='@L["search.colSeeds"]'><MudText Color="Color.Success" Typo="Typo.body2">@context.Seeders</MudText></MudTd>
                <MudTd DataLabel='@L["search.colLeech"]'><MudText Color="Color.Error" Typo="Typo.body2">@context.Leechers</MudText></MudTd>
                <MudTd DataLabel='@L["search.colPublished"]'>@(context.PublishedAt?.ToLocalTime().ToString("yyyy-MM-dd") ?? "-")</MudTd>
                <MudTd>
                    <div class="d-flex gap-1 justify-end">
                        <MudTooltip Text='@L["search.details"]'>
                            <MudIconButton Icon="@Icons.Material.Outlined.Info" Size="Size.Small"
                                           OnClick="@(() => ShowInfoAsync(context))"/>
                        </MudTooltip>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                                   StartIcon="@Icons.Material.Rounded.Download"
                                   OnClick="@(() => DownloadAsync(context))">
                            @L["common.download"]
                        </MudButton>
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>
        </MudPaper>
    }
}

@code {
    private bool _searching;

    // Popular fixed resolutions appended to the query when selected.
    private static readonly string[] Resolutions = { "480p", "720p", "1080p", "2160p" };

    // Query, provider, resolution and results live in the singleton SearchState so they
    // survive navigating away from the page and back.
    private string _query { get => State.Query; set => State.Query = value; }
    private string _provider { get => State.Provider; set => State.Provider = value; }
    private string _resolution { get => State.Resolution; set => State.Resolution = value; }
    private List<TorrentSearchResult>? _results => State.Results;

    private Task OnKeyUp(KeyboardEventArgs e) =>
        e.Key == "Enter" ? SearchAsync() : Task.CompletedTask;

    /// <summary>Combines the text query with the selected resolution into the query sent to providers.</summary>
    private string EffectiveQuery =>
        string.IsNullOrEmpty(_resolution) ? _query.Trim() : $"{_query.Trim()} {_resolution}";

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_query) || _searching) return;
        _searching = true;
        var results = new List<TorrentSearchResult>();
        // Providers overlap (e.g. Torrents-CSV also indexes The Pirate Bay and Nyaa torrents) — keep
        // one row per torrent, preferring whichever provider's entry has more seeders rather than
        // whichever happened to stream in first (an aggregator's cached count can lag behind a
        // source site's live number).
        var byHash = new Dictionary<string, TorrentSearchResult>(StringComparer.OrdinalIgnoreCase);
        State.Results = results;
        try
        {
            await SearchService.SearchStreamAsync(EffectiveQuery, _provider, batch => InvokeAsync(() =>
            {
                foreach (var r in batch)
                {
                    // Only results carrying an info hash can be deduped. A result still awaiting
                    // detail resolution has a blank hash; keying those together would collapse
                    // unrelated torrents into one row (mirrors TorrentSearchService.SearchAsync).
                    if (!string.IsNullOrEmpty(r.InfoHash))
                    {
                        if (byHash.TryGetValue(r.InfoHash, out var existing))
                        {
                            if (r.Seeders <= existing.Seeders) continue;
                            results.Remove(existing);
                        }
                        byHash[r.InfoHash] = r;
                    }
                    results.Add(r);
                }
                results.Sort((a, b) => b.Seeders.CompareTo(a.Seeders));
                StateHasChanged();
            }));
        }
        catch (Exception ex)
        {
            Snackbar.Add(L.Format("search.failed", ex.Message), Severity.Error);
        }
        finally
        {
            _searching = false;
        }
    }

    private async Task ShowInfoAsync(TorrentSearchResult result)
    {
        var parameters = new DialogParameters<TorrentInfoDialog> { { x => x.Result, result } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<TorrentInfoDialog>(L["info.title"], parameters, options);
        var dialogResult = await dialog.Result;
        // The dialog returns true when the user pressed Download from inside it.
        if (dialogResult is { Canceled: false, Data: true })
            await DownloadAsync(result);
    }

    private async Task DownloadAsync(TorrentSearchResult result)
    {
        string defaultFolder;
        await using (var db = await DbFactory.CreateDbContextAsync())
            defaultFolder = (await db.GetSettingsAsync()).DownloadFolder;

        var parameters = new DialogParameters<FolderPromptDialog>
        {
            { x => x.Title, result.Title },
            { x => x.DefaultFolder, defaultFolder }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<FolderPromptDialog>(L["dialog.downloadTitle"], parameters, options);
        var dialogResult = await dialog.Result;
        if (dialogResult is null || dialogResult.Canceled)
            return;

        var folder = dialogResult.Data as string;
        try
        {
            await SearchService.StartDownloadAsync(DownloadManager, result, saveFolder: folder);
            Snackbar.Add(L.Format("search.started", result.Title), Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(L.Format("search.startFailed", ex.Message), Severity.Error);
        }
    }
}
