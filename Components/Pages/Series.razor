@page "/series"
@using MediaDownloader.Components.Dialogs
@inject IDbContextFactory<AppDbContext> DbFactory
@inject TorrentSearchService SearchService
@inject SeriesMonitor SeriesMonitor
@inject DownloadManager DownloadManager
@inject LocalizationService L
@inject IDialogService DialogService
@inject NativeFolderPicker FolderPicker
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>@L["series.title"]</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-6">
    <MudStack Spacing="1">
        <MudText Typo="Typo.h4">@L["series.title"]</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["series.subtitle"]</MudText>
    </MudStack>
    <MudSpacer/>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
               StartIcon="@Icons.Material.Rounded.Add" OnClick="AddTaskAsync">
        @L["series.add"]
    </MudButton>
</MudStack>

@if (_tasks.Count == 0)
{
    <MudPaper Outlined="true" Class="pa-16">
        <MudStack AlignItems="AlignItems.Center" Spacing="4">
            <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Style="width:72px;height:72px;font-size:2rem">
                <MudIcon Icon="@Icons.Material.Rounded.LiveTv" Size="Size.Large"/>
            </MudAvatar>
            <MudStack Spacing="1" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h6">@L["series.emptyTitle"]</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["series.emptyHint"]</MudText>
            </MudStack>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                       StartIcon="@Icons.Material.Rounded.Add" OnClick="AddTaskAsync">@L["series.add"]</MudButton>
        </MudStack>
    </MudPaper>
}

<MudExpansionPanels MultiExpansion="true" Outlined="true" Elevation="0">
    @foreach (var task in _tasks)
    {
        var t = task;
        <MudExpansionPanel>
            <TitleContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudIcon Icon="@Icons.Material.Rounded.LiveTv" Color="@(t.Enabled ? Color.Primary : Color.Default)"/>
                    <MudText Typo="Typo.subtitle1">@(string.IsNullOrWhiteSpace(t.Name) ? L["series.unnamed"] : t.Name)</MudText>
                    @if (t.IsFinished)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Success">@L["series.finished"]</MudChip>
                    }
                    else if (!t.Enabled)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">@L["series.disabled"]</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info">@L.Format("series.next", t.NextEpisode)</MudChip>
                    }
                </MudStack>
            </TitleContent>
            <ChildContent>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="t.Name" @bind-Value:after="() => SaveAsync(t)"
                                      Label="@L["series.name"]" Variant="Variant.Outlined"/>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="t.Query" @bind-Value:after="() => SaveAsync(t)"
                                      Label="@L["series.query"]" Variant="Variant.Outlined"
                                      HelperText="@L["series.queryHelp"]"/>
                    </MudItem>
                    <MudItem xs="12">
                        <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                            <MudTextField @bind-Value="t.DownloadFolder" @bind-Value:after="() => SaveAsync(t)"
                                          Label="@L["series.folder"]" Variant="Variant.Outlined"
                                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Folder"
                                          HelperText="@L["series.folderHelp"]" Class="flex-grow-1"/>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-1"
                                       StartIcon="@Icons.Material.Rounded.FolderOpen"
                                       OnClick="@(() => BrowseFolderAsync(t))">@L["common.browse"]</MudButton>
                        </MudStack>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect T="string" @bind-Value="t.Provider" @bind-Value:after="() => SaveAsync(t)"
                                   Label="@L["search.source"]" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@((string?)null)">@L["search.allSources"]</MudSelectItem>
                            @foreach (var name in SearchService.ProviderNames)
                            {
                                <MudSelectItem T="string" Value="@name">@name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="t.TitleFilter" @bind-Value:after="() => SaveAsync(t)"
                                      Label="@L["series.titleFilter"]" Variant="Variant.Outlined"
                                      HelperText="@L["series.titleFilterHelp"]"/>
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudNumericField T="int?" @bind-Value="t.Season" @bind-Value:after="() => SaveAsync(t)"
                                         Label="@L["series.season"]" Variant="Variant.Outlined" Min="0"/>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudNumericField T="int" @bind-Value="t.StartEpisode" @bind-Value:after="() => SaveAsync(t)"
                                         Label="@L["series.startEpisode"]" Variant="Variant.Outlined" Min="1"/>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudNumericField T="int?" @bind-Value="t.EndEpisode" @bind-Value:after="() => SaveAsync(t)"
                                         Label="@L["series.endEpisode"]" Variant="Variant.Outlined" Min="1"/>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudNumericField T="int" @bind-Value="t.CheckIntervalMinutes" @bind-Value:after="() => SaveAsync(t)"
                                         Label="@L["series.checkEvery"]" Variant="Variant.Outlined" Min="5"/>
                    </MudItem>
                    <MudItem xs="6" sm="3" Class="d-flex align-center">
                        <MudSwitch T="bool" @bind-Value="t.Enabled" @bind-Value:after="() => SaveAsync(t)"
                                   Label="@L["series.enabled"]" Color="Color.Primary"/>
                    </MudItem>
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @L["series.lastDownloaded"]: @(t.LastDownloadedEpisode == 0 ? L["series.nothingYet"] : L.Format("series.episode", t.LastDownloadedEpisode)) ·
                            @L["series.lastChecked"]: @(t.LastCheckedAt?.ToLocalTime().ToString("g") ?? L["series.never"])
                        </MudText>
                    </MudItem>

                    @{
                        var taskDownloads = DownloadsFor(t.Id);
                    }
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">@L.Format("series.downloads", taskDownloads.Count)</MudText>
                        @if (taskDownloads.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["series.noDownloads"]</MudText>
                        }
                        else
                        {
                            <MudPaper Outlined="true" Class="overflow-hidden">
                                <MudTable Items="taskDownloads" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.Sm">
                                    <HeaderContent>
                                        <MudTh>@L["downloads.colName"]</MudTh>
                                        <MudTh Style="width:180px">@L["downloads.colProgress"]</MudTh>
                                        <MudTh>@L["downloads.colStatus"]</MudTh>
                                        <MudTh Style="width:120px"></MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel='@L["downloads.colName"]'>
                                            <MudText Typo="Typo.body2" Style="word-break:break-all">@context.Name</MudText>
                                            @if (context.Error is not null)
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Error">@context.Error</MudText>
                                            }
                                        </MudTd>
                                        <MudTd DataLabel='@L["downloads.colProgress"]'>
                                            <MudProgressLinear Color="@DownloadStatusDisplay.ProgressColor(context)" Value="@context.Progress"
                                                               Rounded="true" Size="Size.Medium" Class="my-1">
                                                <MudText Typo="Typo.caption">@($"{context.Progress:0.#}%")</MudText>
                                            </MudProgressLinear>
                                        </MudTd>
                                        <MudTd DataLabel='@L["downloads.colStatus"]'>
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@DownloadStatusDisplay.StatusColor(context.Status)">@DownloadStatusDisplay.StatusText(context.Status, L)</MudChip>
                                        </MudTd>
                                        <MudTd>
                                            @if (context.Status is DownloadStatus.Downloading or DownloadStatus.FetchingMetadata or DownloadStatus.Seeding or DownloadStatus.Queued)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Pause" Size="Size.Small"
                                                               OnClick="@(() => DownloadManager.PauseAsync(context.Id))" title='@L["common.pause"]'/>
                                            }
                                            else if (context.Status is DownloadStatus.Paused)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small"
                                                               OnClick="@(() => DownloadManager.ResumeAsync(context.Id))" title='@L["common.resume"]'/>
                                            }
                                            else if (context.Status is DownloadStatus.Error)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                                                               OnClick="@(() => DownloadManager.ResumeAsync(context.Id))" title='@L["common.retry"]'/>
                                            }
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                           OnClick="@(() => DownloadStatusDisplay.ConfirmDeleteAsync(DialogService, DownloadManager, L, context))" title='@L["common.delete"]'/>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudPaper>
                        }
                    </MudItem>

                    <MudItem xs="12" Class="d-flex gap-2">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Rounded.Refresh" Disabled="@_checking"
                                   OnClick="@(() => CheckNowAsync(t))">
                            @L["series.checkNow"]
                        </MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                   StartIcon="@Icons.Material.Rounded.Delete"
                                   OnClick="@(() => DeleteAsync(t))">
                            @L["series.deleteTask"]
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </ChildContent>
        </MudExpansionPanel>
    }
</MudExpansionPanels>

@code {
    private List<SeriesTask> _tasks = new();
    private bool _checking;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        SeriesMonitor.SeriesChanged += OnSeriesChanged;
        DownloadManager.DownloadsChanged += OnDownloadsChanged;
        L.LanguageChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    private List<DownloadItem> DownloadsFor(int taskId) =>
        DownloadManager.GetDownloads().Where(d => d.SeriesTaskId == taskId).ToList();

    private void OnDownloadsChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _tasks = await db.SeriesTasks.OrderBy(t => t.Id).ToListAsync();
    }

    private void OnSeriesChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private async Task AddTaskAsync()
    {
        // Start disabled so the monitor doesn't act on an unconfigured task.
        var task = new SeriesTask { Name = "New series", CheckIntervalMinutes = 60, StartEpisode = 1, Enabled = false };
        await using var db = await DbFactory.CreateDbContextAsync();
        db.SeriesTasks.Add(task);
        await db.SaveChangesAsync();
        _tasks.Add(task);
    }

    private async Task SaveAsync(SeriesTask task)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        db.SeriesTasks.Update(task);
        await db.SaveChangesAsync();
    }

    private async Task BrowseFolderAsync(SeriesTask task)
    {
        var start = task.DownloadFolder;
        if (string.IsNullOrWhiteSpace(start))
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            start = (await db.GetSettingsAsync()).DownloadFolder;
        }

        if (FolderPicker.IsSupported)
        {
            var picked = await FolderPicker.PickFolderAsync(start, L["dialog.chooseDownloadFolder"]);
            if (picked is null)
                return;
            task.DownloadFolder = picked;
        }
        else
        {
            // Non-macOS fallback: the in-browser folder picker.
            var parameters = new DialogParameters<FolderBrowserDialog> { { x => x.StartFolder, start } };
            var dialog = await DialogService.ShowAsync<FolderBrowserDialog>(L["dialog.chooseFolder"], parameters);
            var result = await dialog.Result;
            if (result is null || result.Canceled)
                return;
            task.DownloadFolder = result.Data as string;
        }

        await SaveAsync(task);
    }

    private async Task CheckNowAsync(SeriesTask task)
    {
        _checking = true;
        try
        {
            await SeriesMonitor.CheckTaskNowAsync(task.Id);
            await LoadAsync();
            Snackbar.Add(L["series.checkDone"], Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add(L.Format("series.checkFailed", ex.Message), Severity.Error);
        }
        finally
        {
            _checking = false;
        }
    }

    private async Task DeleteAsync(SeriesTask task)
    {
        // Deleting a task doesn't cancel or delete its downloads (the FK is SetNull) — they simply
        // become "manual" downloads on the Downloads page. Warn about that explicitly so it isn't
        // a silent surprise, same as deleting a single download already confirms.
        var downloadCount = DownloadsFor(task.Id).Count;
        var message = downloadCount > 0
            ? L.Format("series.deleteConfirmWithDownloads", task.Name, downloadCount)
            : L.Format("series.deleteConfirm", task.Name);
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["series.deleteTaskTitle"], message,
            yesText: L["common.delete"], cancelText: L["common.cancel"]);
        if (confirmed != true)
            return;

        await using var db = await DbFactory.CreateDbContextAsync();
        db.SeriesTasks.Remove(task);
        await db.SaveChangesAsync();
        _tasks.Remove(task);
    }

    public void Dispose()
    {
        SeriesMonitor.SeriesChanged -= OnSeriesChanged;
        DownloadManager.DownloadsChanged -= OnDownloadsChanged;
        L.LanguageChanged -= OnLanguageChanged;
    }
}
