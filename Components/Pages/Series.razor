@page "/series"
@using MediaDownloader.Components.Dialogs
@inject IDbContextFactory<AppDbContext> DbFactory
@inject TorrentSearchService SearchService
@inject SeriesMonitor SeriesMonitor
@inject DownloadManager DownloadManager
@inject IDialogService DialogService
@inject NativeFolderPicker FolderPicker
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Series Tasks</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-6">
    <MudStack Spacing="1">
        <MudText Typo="Typo.h4">Series Tasks</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Each task periodically checks for the next episode and downloads it automatically. Changes save automatically.
        </MudText>
    </MudStack>
    <MudSpacer/>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
               StartIcon="@Icons.Material.Rounded.Add" OnClick="AddTaskAsync">
        Add series
    </MudButton>
</MudStack>

@if (_tasks.Count == 0)
{
    <MudPaper Outlined="true" Class="pa-16">
        <MudStack AlignItems="AlignItems.Center" Spacing="4">
            <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Style="width:72px;height:72px;font-size:2rem">
                <MudIcon Icon="@Icons.Material.Rounded.LiveTv" Size="Size.Large"/>
            </MudAvatar>
            <MudStack Spacing="1" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h6">No series tasks yet</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Create one and new episodes will download themselves.</MudText>
            </MudStack>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                       StartIcon="@Icons.Material.Rounded.Add" OnClick="AddTaskAsync">Add series</MudButton>
        </MudStack>
    </MudPaper>
}

<MudExpansionPanels MultiExpansion="true" Outlined="true" Elevation="0">
    @foreach (var task in _tasks)
    {
        var t = task;
        <MudExpansionPanel>
            <TitleContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudIcon Icon="@Icons.Material.Rounded.LiveTv" Color="@(t.Enabled ? Color.Primary : Color.Default)"/>
                    <MudText Typo="Typo.subtitle1">@(string.IsNullOrWhiteSpace(t.Name) ? "(unnamed series)" : t.Name)</MudText>
                    @if (t.IsFinished)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Success">Finished</MudChip>
                    }
                    else if (!t.Enabled)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">Disabled</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info">Next: Ep @t.NextEpisode</MudChip>
                    }
                </MudStack>
            </TitleContent>
            <ChildContent>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="t.Name" @bind-Value:after="() => SaveAsync(t)"
                                      Label="Name" Variant="Variant.Outlined"/>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="t.Query" @bind-Value:after="() => SaveAsync(t)"
                                      Label="Search query" Variant="Variant.Outlined"
                                      HelperText="e.g. 'One Piece 1080p' — sent to the torrent site"/>
                    </MudItem>
                    <MudItem xs="12">
                        <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                            <MudTextField @bind-Value="t.DownloadFolder" @bind-Value:after="() => SaveAsync(t)"
                                          Label="Download folder (optional)" Variant="Variant.Outlined"
                                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Folder"
                                          HelperText="Leave empty to use the default folder from Settings" Class="flex-grow-1"/>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-1"
                                       StartIcon="@Icons.Material.Rounded.FolderOpen"
                                       OnClick="@(() => BrowseFolderAsync(t))">Browse</MudButton>
                        </MudStack>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect T="string" @bind-Value="t.Provider" @bind-Value:after="() => SaveAsync(t)"
                                   Label="Source" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@((string?)null)">All sources</MudSelectItem>
                            @foreach (var name in SearchService.ProviderNames)
                            {
                                <MudSelectItem T="string" Value="@name">@name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="t.TitleFilter" @bind-Value:after="() => SaveAsync(t)"
                                      Label="Title must contain (optional)" Variant="Variant.Outlined"
                                      HelperText="e.g. '1080p' or a release group"/>
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudNumericField T="int?" @bind-Value="t.Season" @bind-Value:after="() => SaveAsync(t)"
                                         Label="Season (optional)" Variant="Variant.Outlined" Min="0"/>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudNumericField T="int" @bind-Value="t.StartEpisode" @bind-Value:after="() => SaveAsync(t)"
                                         Label="Start episode" Variant="Variant.Outlined" Min="1"/>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudNumericField T="int?" @bind-Value="t.EndEpisode" @bind-Value:after="() => SaveAsync(t)"
                                         Label="End episode (optional)" Variant="Variant.Outlined" Min="1"/>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudNumericField T="int" @bind-Value="t.CheckIntervalMinutes" @bind-Value:after="() => SaveAsync(t)"
                                         Label="Check every (minutes)" Variant="Variant.Outlined" Min="5"/>
                    </MudItem>
                    <MudItem xs="6" sm="3" Class="d-flex align-center">
                        <MudSwitch T="bool" @bind-Value="t.Enabled" @bind-Value:after="() => SaveAsync(t)"
                                   Label="Enabled" Color="Color.Primary"/>
                    </MudItem>
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Last downloaded: @(t.LastDownloadedEpisode == 0 ? "nothing yet" : $"episode {t.LastDownloadedEpisode}") ·
                            Last checked: @(t.LastCheckedAt?.ToLocalTime().ToString("g") ?? "never")
                        </MudText>
                    </MudItem>

                    @{
                        var taskDownloads = DownloadsFor(t.Id);
                    }
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Downloads (@taskDownloads.Count)</MudText>
                        @if (taskDownloads.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                Nothing downloaded for this series yet.
                            </MudText>
                        }
                        else
                        {
                            <MudPaper Outlined="true" Class="overflow-hidden">
                                <MudTable Items="taskDownloads" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.Sm">
                                    <HeaderContent>
                                        <MudTh>Name</MudTh>
                                        <MudTh Style="width:180px">Progress</MudTh>
                                        <MudTh>Status</MudTh>
                                        <MudTh Style="width:120px"></MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Name">
                                            <MudText Typo="Typo.body2" Style="word-break:break-all">@context.Name</MudText>
                                            @if (context.Error is not null)
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Error">@context.Error</MudText>
                                            }
                                        </MudTd>
                                        <MudTd DataLabel="Progress">
                                            <MudProgressLinear Color="@ProgressColor(context)" Value="@context.Progress"
                                                               Rounded="true" Size="Size.Medium" Class="my-1">
                                                <MudText Typo="Typo.caption">@($"{context.Progress:0.#}%")</MudText>
                                            </MudProgressLinear>
                                        </MudTd>
                                        <MudTd DataLabel="Status">
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@StatusColor(context.Status)">@StatusText(context.Status)</MudChip>
                                        </MudTd>
                                        <MudTd>
                                            @if (context.Status is DownloadStatus.Downloading or DownloadStatus.FetchingMetadata or DownloadStatus.Seeding or DownloadStatus.Queued)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Pause" Size="Size.Small"
                                                               OnClick="@(() => DownloadManager.PauseAsync(context.Id))" title="Pause"/>
                                            }
                                            else if (context.Status is DownloadStatus.Paused)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small"
                                                               OnClick="@(() => DownloadManager.ResumeAsync(context.Id))" title="Resume"/>
                                            }
                                            else if (context.Status is DownloadStatus.Error)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                                                               OnClick="@(() => DownloadManager.ResumeAsync(context.Id))" title="Retry"/>
                                            }
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                           OnClick="@(() => ConfirmDeleteDownloadAsync(context))" title="Delete"/>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudPaper>
                        }
                    </MudItem>

                    <MudItem xs="12" Class="d-flex gap-2">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Rounded.Refresh" Disabled="@_checking"
                                   OnClick="@(() => CheckNowAsync(t))">
                            Check now
                        </MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                   StartIcon="@Icons.Material.Rounded.Delete"
                                   OnClick="@(() => DeleteAsync(t))">
                            Delete task
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </ChildContent>
        </MudExpansionPanel>
    }
</MudExpansionPanels>

@code {
    private List<SeriesTask> _tasks = new();
    private bool _checking;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        SeriesMonitor.SeriesChanged += OnSeriesChanged;
        DownloadManager.DownloadsChanged += OnDownloadsChanged;
    }

    private List<DownloadItem> DownloadsFor(int taskId) =>
        DownloadManager.GetDownloads().Where(d => d.SeriesTaskId == taskId).ToList();

    private void OnDownloadsChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task ConfirmDeleteDownloadAsync(DownloadItem item)
    {
        var deleteFiles = await DialogService.ShowMessageBoxAsync(
            "Delete download",
            $"Delete \"{item.Name}\"? Choose whether to also delete the downloaded files.",
            yesText: "Delete files too", noText: "Keep files", cancelText: "Cancel");

        if (deleteFiles is null) return;
        await DownloadManager.DeleteAsync(item.Id, deleteFiles.Value);
    }

    private static Color ProgressColor(DownloadItem d) => d.Status switch
    {
        DownloadStatus.Completed or DownloadStatus.Seeding => Color.Success,
        DownloadStatus.Error => Color.Error,
        DownloadStatus.Paused => Color.Warning,
        _ => Color.Primary
    };

    private static Color StatusColor(DownloadStatus s) => s switch
    {
        DownloadStatus.Downloading => Color.Primary,
        DownloadStatus.Seeding or DownloadStatus.Completed => Color.Success,
        DownloadStatus.Paused => Color.Warning,
        DownloadStatus.Error => Color.Error,
        _ => Color.Default
    };

    private static string StatusText(DownloadStatus s) => s switch
    {
        DownloadStatus.FetchingMetadata => "Fetching metadata",
        _ => s.ToString()
    };

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _tasks = await db.SeriesTasks.OrderBy(t => t.Id).ToListAsync();
    }

    private void OnSeriesChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private async Task AddTaskAsync()
    {
        // Start disabled so the monitor doesn't act on an unconfigured task.
        var task = new SeriesTask { Name = "New series", CheckIntervalMinutes = 60, StartEpisode = 1, Enabled = false };
        await using var db = await DbFactory.CreateDbContextAsync();
        db.SeriesTasks.Add(task);
        await db.SaveChangesAsync();
        _tasks.Add(task);
    }

    private async Task SaveAsync(SeriesTask task)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        db.SeriesTasks.Update(task);
        await db.SaveChangesAsync();
    }

    private async Task BrowseFolderAsync(SeriesTask task)
    {
        var start = task.DownloadFolder;
        if (string.IsNullOrWhiteSpace(start))
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            start = (await db.GetSettingsAsync()).DownloadFolder;
        }

        if (FolderPicker.IsSupported)
        {
            var picked = await FolderPicker.PickFolderAsync(start, "Choose download folder");
            if (picked is null)
                return;
            task.DownloadFolder = picked;
        }
        else
        {
            // Non-macOS fallback: the in-browser folder picker.
            var parameters = new DialogParameters<FolderBrowserDialog> { { x => x.StartFolder, start } };
            var dialog = await DialogService.ShowAsync<FolderBrowserDialog>("Choose folder", parameters);
            var result = await dialog.Result;
            if (result is null || result.Canceled)
                return;
            task.DownloadFolder = result.Data as string;
        }

        await SaveAsync(task);
    }

    private async Task CheckNowAsync(SeriesTask task)
    {
        _checking = true;
        try
        {
            await SeriesMonitor.CheckTaskNowAsync(task.Id);
            await LoadAsync();
            Snackbar.Add("Check completed", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Check failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _checking = false;
        }
    }

    private async Task DeleteAsync(SeriesTask task)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        db.SeriesTasks.Remove(task);
        await db.SaveChangesAsync();
        _tasks.Remove(task);
    }

    public void Dispose()
    {
        SeriesMonitor.SeriesChanged -= OnSeriesChanged;
        DownloadManager.DownloadsChanged -= OnDownloadsChanged;
    }
}
