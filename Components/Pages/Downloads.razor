@page "/"
@inject DownloadManager DownloadManager
@inject SeriesMonitor SeriesMonitor
@inject IDbContextFactory<AppDbContext> DbFactory
@inject LocalizationService L
@inject IDialogService DialogService
@implements IDisposable

<PageTitle>@L["downloads.title"]</PageTitle>

<MudStack Spacing="1" Class="mb-6">
    <MudText Typo="Typo.h4">@L["downloads.title"]</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["downloads.subtitle"]</MudText>
</MudStack>

@if (_downloads.Count == 0)
{
    <MudPaper Outlined="true" Class="pa-16">
        <MudStack AlignItems="AlignItems.Center" Spacing="4">
            <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Style="width:72px;height:72px;font-size:2rem">
                <MudIcon Icon="@Icons.Material.Rounded.CloudDownload" Size="Size.Large"/>
            </MudAvatar>
            <MudStack Spacing="1" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h6">@L["downloads.emptyTitle"]</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary" Align="Align.Center">
                    @L["downloads.emptyHint"]
                </MudText>
            </MudStack>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                           StartIcon="@Icons.Material.Rounded.Search" Href="/search">@L["downloads.searchButton"]</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Rounded.LiveTv" Href="/series">@L["downloads.seriesButton"]</MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>
}
else
{
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" sm="4">
            <MudPaper Outlined="true" Class="pa-4 d-flex align-center gap-4">
                <MudAvatar Color="Color.Primary" Variant="Variant.Outlined">
                    <MudIcon Icon="@Icons.Material.Rounded.Downloading"/>
                </MudAvatar>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6">@ActiveCount</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["downloads.active"]</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4">
            <MudPaper Outlined="true" Class="pa-4 d-flex align-center gap-4">
                <MudAvatar Color="Color.Success" Variant="Variant.Outlined">
                    <MudIcon Icon="@Icons.Material.Rounded.ArrowDownward"/>
                </MudAvatar>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6">@FormatSpeed(TotalDownSpeed)</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["downloads.download"]</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4">
            <MudPaper Outlined="true" Class="pa-4 d-flex align-center gap-4">
                <MudAvatar Color="Color.Info" Variant="Variant.Outlined">
                    <MudIcon Icon="@Icons.Material.Rounded.ArrowUpward"/>
                </MudAvatar>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6">@FormatSpeed(TotalUpSpeed)</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["downloads.upload"]</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudTabs Elevation="0" Rounded="true" Border="true" ApplyEffectsToContainer="true" Class="mt-2">
        <MudTabPanel Text='@L.Format("downloads.manualTab", _manual.Count)' Icon="@Icons.Material.Rounded.Person">
            @if (_manual.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">@L["downloads.noManual"]</MudText>
            }
            else
            {
                <MudPaper Outlined="true" Class="overflow-hidden">
                    <MudTable Items="_manual" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Elevation="0">
                        <HeaderContent>
                            <MudTh><MudTableSortLabel SortBy="new Func<DownloadItem, object>(d => d.Name)">@L["downloads.colName"]</MudTableSortLabel></MudTh>
                            <MudTh Style="width:220px"><MudTableSortLabel SortBy="new Func<DownloadItem, object>(d => d.Progress)">@L["downloads.colProgress"]</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<DownloadItem, object>(d => d.Status)">@L["downloads.colStatus"]</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<DownloadItem, object>(d => d.DownloadSpeed)">@L["downloads.colSpeed"]</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<DownloadItem, object>(d => d.TotalBytes)">@L["downloads.colSize"]</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<DownloadItem, object>(d => d.Peers)">@L["downloads.colPeers"]</MudTableSortLabel></MudTh>
                            <MudTh Style="width:140px"></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            @DownloadRow(context, showActions: true)
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            }
        </MudTabPanel>

        <MudTabPanel Text='@L.Format("downloads.seriesTab", _automatic.Count)' Icon="@Icons.Material.Rounded.LiveTv">
            @if (_automatic.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">@L["downloads.noAuto"]</MudText>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3"
                          Icon="@Icons.Material.Rounded.Info">
                    @L["downloads.autoInfo"]
                </MudAlert>
                <MudPaper Outlined="true" Class="overflow-hidden">
                    <MudTable Items="_automatic" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Elevation="0">
                        <HeaderContent>
                            <MudTh><MudTableSortLabel SortBy="new Func<DownloadItem, object>(d => d.Name)">@L["downloads.colName"]</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<DownloadItem, object>(d => SeriesName(d))">@L["downloads.colSeries"]</MudTableSortLabel></MudTh>
                            <MudTh Style="width:220px"><MudTableSortLabel SortBy="new Func<DownloadItem, object>(d => d.Progress)">@L["downloads.colProgress"]</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<DownloadItem, object>(d => d.Status)">@L["downloads.colStatus"]</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<DownloadItem, object>(d => d.DownloadSpeed)">@L["downloads.colSpeed"]</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<DownloadItem, object>(d => d.TotalBytes)">@L["downloads.colSize"]</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<DownloadItem, object>(d => d.Peers)">@L["downloads.colPeers"]</MudTableSortLabel></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            @DownloadRow(context, showActions: false, seriesName: SeriesName(context))
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            }
        </MudTabPanel>
    </MudTabs>
}

@code {
    private IReadOnlyList<DownloadItem> _downloads = Array.Empty<DownloadItem>();
    private Dictionary<int, string> _seriesNames = new();

    private List<DownloadItem> _manual = new();
    private List<DownloadItem> _automatic = new();

    private int ActiveCount => _downloads.Count(d =>
        d.Status is DownloadStatus.Downloading or DownloadStatus.FetchingMetadata or DownloadStatus.Queued);

    private long TotalDownSpeed => _downloads.Sum(d => d.DownloadSpeed);
    private long TotalUpSpeed => _downloads.Sum(d => d.UploadSpeed);

    protected override async Task OnInitializedAsync()
    {
        await LoadSeriesNamesAsync();
        Refresh();
        DownloadManager.DownloadsChanged += OnDownloadsChanged;
        SeriesMonitor.SeriesChanged += OnSeriesChanged;
        L.LanguageChanged += OnLanguageChanged;
    }

    private async Task LoadSeriesNamesAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _seriesNames = await db.SeriesTasks.ToDictionaryAsync(t => t.Id, t => t.Name);
    }

    private void Refresh()
    {
        _downloads = DownloadManager.GetDownloads();
        _manual = _downloads.Where(d => d.SeriesTaskId is null).ToList();
        _automatic = _downloads.Where(d => d.SeriesTaskId is not null).ToList();
    }

    private string SeriesName(DownloadItem d) =>
        d.SeriesTaskId is { } id && _seriesNames.TryGetValue(id, out var name) && !string.IsNullOrWhiteSpace(name)
            ? name
            : L["downloads.unknownSeries"];

    private void OnDownloadsChanged()
    {
        _ = InvokeAsync(() =>
        {
            Refresh();
            StateHasChanged();
        });
    }

    // Keeps series names (and the manual/automatic split, since a series could be deleted) in sync
    // when a series is added/renamed/deleted while this page is already open.
    private void OnSeriesChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadSeriesNamesAsync();
            StateHasChanged();
        });
    }

    private static string FormatSpeed(long bytesPerSecond) => ByteSize.FormatRate(bytesPerSecond);

    private static string FormatSize(long bytes) => ByteSize.Format(bytes);

    public void Dispose()
    {
        DownloadManager.DownloadsChanged -= OnDownloadsChanged;
        SeriesMonitor.SeriesChanged -= OnSeriesChanged;
        L.LanguageChanged -= OnLanguageChanged;
    }

    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    private RenderFragment DownloadRow(DownloadItem context, bool showActions, string? seriesName = null) =>@<text>
        <MudTd DataLabel='@L["downloads.colName"]'>
            <MudText Typo="Typo.body2" Style="word-break:break-all">@context.Name</MudText>
            @if (context.Error is not null)
            {
                <MudText Typo="Typo.caption" Color="Color.Error">@context.Error</MudText>
            }
        </MudTd>
        @if (seriesName is not null)
        {
            <MudTd DataLabel='@L["downloads.colSeries"]'>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary">@seriesName</MudChip>
            </MudTd>
        }
        <MudTd DataLabel='@L["downloads.colProgress"]'>
            <MudProgressLinear Color="@DownloadStatusDisplay.ProgressColor(context)" Value="@context.Progress" Class="my-1" Rounded="true" Size="Size.Medium">
                <MudText Typo="Typo.caption">@($"{context.Progress:0.#}%")</MudText>
            </MudProgressLinear>
        </MudTd>
        <MudTd DataLabel='@L["downloads.colStatus"]'>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@DownloadStatusDisplay.StatusColor(context.Status)">@DownloadStatusDisplay.StatusText(context.Status, L)</MudChip>
        </MudTd>
        <MudTd DataLabel='@L["downloads.colSpeed"]'>
            @if (context.DownloadSpeed > 0 || context.UploadSpeed > 0)
            {
                <MudText Typo="Typo.caption">↓ @FormatSpeed(context.DownloadSpeed)<br/>↑ @FormatSpeed(context.UploadSpeed)</MudText>
            }
        </MudTd>
        <MudTd DataLabel='@L["downloads.colSize"]'><MudText Typo="Typo.caption">@FormatSize(context.TotalBytes)</MudText></MudTd>
        <MudTd DataLabel='@L["downloads.colPeers"]'><MudText Typo="Typo.caption">@context.Peers</MudText></MudTd>
        @if (showActions)
        {
            <MudTd>
                @if (context.Status is DownloadStatus.Downloading or DownloadStatus.FetchingMetadata or DownloadStatus.Seeding or DownloadStatus.Queued)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Pause" Size="Size.Small"
                                   OnClick="@(() => DownloadManager.PauseAsync(context.Id))" title='@L["common.pause"]'/>
                }
                else if (context.Status is DownloadStatus.Paused)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small"
                                   OnClick="@(() => DownloadManager.ResumeAsync(context.Id))" title='@L["common.resume"]'/>
                }
                else if (context.Status is DownloadStatus.Error)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                                   OnClick="@(() => DownloadManager.ResumeAsync(context.Id))" title='@L["common.retry"]'/>
                }
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => DownloadStatusDisplay.ConfirmDeleteAsync(DialogService, DownloadManager, L, context))" title='@L["common.delete"]'/>
            </MudTd>
        }
    </text>;
}
