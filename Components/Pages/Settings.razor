@page "/settings"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NotificationDispatcher Notifications
@inject TorrentSearchService SearchService
@inject ISnackbar Snackbar

<PageTitle>Settings</PageTitle>

<MudStack Spacing="1" Class="mb-6">
    <MudText Typo="Typo.h4">Settings</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">All changes are saved automatically</MudText>
</MudStack>

@if (_settings is null)
{
    <MudProgressLinear Indeterminate="true"/>
}
else
{
    <MudPaper Outlined="true" Class="pa-6 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Rounded.Tune" Color="Color.Primary"/>
            <MudText Typo="Typo.h6">General</MudText>
        </MudStack>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="_settings.DownloadFolder" @bind-Value:after="SaveAsync"
                              Label="Download folder" Variant="Variant.Outlined"/>
            </MudItem>
            <MudItem xs="6" sm="2" Class="d-flex align-center">
                <MudSwitch T="bool" @bind-Value="_settings.NotifyOnStart" @bind-Value:after="SaveAsync"
                           Label="Notify on start" Color="Color.Primary"/>
            </MudItem>
            <MudItem xs="6" sm="2" Class="d-flex align-center">
                <MudSwitch T="bool" @bind-Value="_settings.NotifyOnComplete" @bind-Value:after="SaveAsync"
                           Label="Notify on finish" Color="Color.Primary"/>
            </MudItem>
            <MudItem xs="12" sm="8">
                <MudSelect T="PostDownloadAction" @bind-Value="_settings.PostDownloadAction" @bind-Value:after="SaveAsync"
                           Label="When a download finishes" Variant="Variant.Outlined"
                           HelperText="@PostDownloadHelp">
                    <MudSelectItem Value="PostDownloadAction.StopSeeding">Stop seeding</MudSelectItem>
                    <MudSelectItem Value="PostDownloadAction.KeepSeeding">Keep seeding</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-6 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Rounded.Dns" Color="Color.Primary"/>
            <MudText Typo="Typo.h6">Search sources</MudText>
        </MudStack>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            Turn a source off to exclude it from searches — useful for sources that return junk or dead torrents.
        </MudText>
        <MudGrid Spacing="2">
            @foreach (var name in SearchService.ProviderNames)
            {
                var providerName = name;
                <MudItem xs="12" sm="6">
                    <MudSwitch T="bool" Color="Color.Primary"
                               Value="_settings.IsProviderEnabled(providerName)"
                               ValueChanged="@(v => ToggleProviderAsync(providerName, v))"
                               Label="@providerName"/>
                </MudItem>
            }
        </MudGrid>
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-6 mb-4">
        <div class="d-flex align-center gap-3 mb-3">
            <MudIcon Icon="@Icons.Material.Rounded.NotificationsActive" Color="Color.Primary"/>
            <MudText Typo="Typo.h6">Desktop notifications</MudText>
            <MudSpacer/>
            <MudSwitch T="bool" @bind-Value="_settings.DesktopEnabled" @bind-Value:after="SaveAsync" Color="Color.Primary"/>
        </div>
        <MudText Typo="Typo.body2" class="mud-text-secondary">
            Shown through the browser. Allow notifications for this site when the browser asks.
        </MudText>
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-6 mb-4">
        <div class="d-flex align-center gap-3 mb-3">
            <MudIcon Icon="@Icons.Material.Rounded.MailOutline" Color="Color.Primary"/>
            <MudText Typo="Typo.h6">Email (SMTP)</MudText>
            <MudSpacer/>
            <MudSwitch T="bool" @bind-Value="_settings.EmailEnabled" @bind-Value:after="SaveAsync" Color="Color.Primary"/>
        </div>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="5">
                <MudTextField @bind-Value="_settings.SmtpHost" @bind-Value:after="SaveAsync"
                              Label="SMTP host" Variant="Variant.Outlined"/>
            </MudItem>
            <MudItem xs="6" sm="2">
                <MudNumericField T="int" @bind-Value="_settings.SmtpPort" @bind-Value:after="SaveAsync"
                                 Label="Port" Variant="Variant.Outlined" Min="1" Max="65535"/>
            </MudItem>
            <MudItem xs="6" sm="2" Class="d-flex align-center">
                <MudSwitch T="bool" @bind-Value="_settings.SmtpUseSsl" @bind-Value:after="SaveAsync"
                           Label="SSL/TLS" Color="Color.Primary"/>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="_settings.SmtpUsername" @bind-Value:after="SaveAsync"
                              Label="Username" Variant="Variant.Outlined"/>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_settings.SmtpPassword" @bind-Value:after="SaveAsync"
                              Label="Password" Variant="Variant.Outlined" InputType="InputType.Password"/>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_settings.EmailFrom" @bind-Value:after="SaveAsync"
                              Label="From address" Variant="Variant.Outlined"/>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_settings.EmailTo" @bind-Value:after="SaveAsync"
                              Label="To address" Variant="Variant.Outlined"/>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-6 mb-4">
        <div class="d-flex align-center gap-3 mb-3">
            <MudIcon Icon="@Icons.Material.Rounded.PhoneIphone" Color="Color.Primary"/>
            <MudText Typo="Typo.h6">Push notifications (ntfy)</MudText>
            <MudSpacer/>
            <MudSwitch T="bool" @bind-Value="_settings.PushEnabled" @bind-Value:after="SaveAsync" Color="Color.Primary"/>
        </div>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_settings.NtfyServer" @bind-Value:after="SaveAsync"
                              Label="ntfy server" Variant="Variant.Outlined"/>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_settings.NtfyTopic" @bind-Value:after="SaveAsync"
                              Label="Topic" Variant="Variant.Outlined"
                              HelperText="Subscribe to this topic in the ntfy app to receive pushes on your phone"/>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-6 mb-4">
        <div class="d-flex align-center gap-3 mb-3">
            <MudIcon Icon="@Icons.Material.Rounded.Send" Color="Color.Primary"/>
            <MudText Typo="Typo.h6">Telegram bot</MudText>
            <MudSpacer/>
            <MudSwitch T="bool" @bind-Value="_settings.TelegramEnabled" @bind-Value:after="SaveAsync" Color="Color.Primary"/>
        </div>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_settings.TelegramBotToken" @bind-Value:after="SaveAsync"
                              Label="Bot token" Variant="Variant.Outlined" InputType="InputType.Password"
                              HelperText="@("Create a bot with @BotFather to get a token")"/>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_settings.TelegramChatId" @bind-Value:after="SaveAsync"
                              Label="Chat ID" Variant="Variant.Outlined"
                              HelperText="@("Your chat id — message @userinfobot to find it, then send /start to your bot")"/>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
               StartIcon="@Icons.Material.Rounded.NotificationsActive"
               Disabled="_testing" OnClick="SendTestAsync">
        Send test notification
    </MudButton>
}

@code {
    private AppSettings? _settings;
    private bool _testing;

    private string PostDownloadHelp => _settings?.PostDownloadAction switch
    {
        PostDownloadAction.KeepSeeding => "Completed torrents keep seeding to other peers until you pause or remove them.",
        _ => "Completed torrents stop immediately and no longer upload."
    };

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _settings = await db.GetSettingsAsync();
    }

    private async Task SaveAsync()
    {
        if (_settings is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        db.Settings.Update(_settings);
        await db.SaveChangesAsync();
    }

    private async Task ToggleProviderAsync(string name, bool enabled)
    {
        if (_settings is null) return;
        _settings.SetProviderEnabled(name, enabled);
        await SaveAsync();
    }

    private async Task SendTestAsync()
    {
        _testing = true;
        try
        {
            await Notifications.DispatchAsync(new NotificationEvent(
                NotificationKind.DownloadStarted, "Test notification",
                "If you can read this, notifications are working."));
            Snackbar.Add("Test notification dispatched to all enabled channels", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Test failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _testing = false;
        }
    }
}
