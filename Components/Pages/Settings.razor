@page "/settings"
@inherits LocalizedComponentBase
@using System.ComponentModel.DataAnnotations
@inject AppSettingsService SettingsService
@inject NotificationDispatcher Notifications
@inject TorrentSearchService SearchService
@inject UpdateService Updates
@inject AgentAccess AgentAccess
@inject AgentEndpointInfo AgentEndpoint
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>@L["settings.title"]</PageTitle>

<MudStack Spacing="1" Class="mb-6">
    <MudText Typo="Typo.h4">@L["settings.title"]</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["settings.subtitle"]</MudText>
</MudStack>

@if (_settings is null)
{
    <MudProgressLinear Indeterminate="true"/>
}
else
{
    <MudPaper Outlined="true" Class="pa-6 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Rounded.Tune" Color="Color.Primary"/>
            <MudText Typo="Typo.h6">@L["settings.general"]</MudText>
        </MudStack>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="_settings.DownloadFolder" @bind-Value:after="SaveAsync"
                              Label="@L["settings.downloadFolder"]" Variant="Variant.Outlined"/>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="string" Value="_settings.Language" ValueChanged="ChangeLanguageAsync"
                           Label="@L["settings.language"]" Variant="Variant.Outlined"
                           AdornmentIcon="@Icons.Material.Rounded.Language" Adornment="Adornment.Start">
                    @foreach (var lang in L.Languages)
                    {
                        <MudSelectItem T="string" Value="@lang.Code">@lang.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="6" sm="3" Class="d-flex align-center">
                <MudSwitch T="bool" @bind-Value="_settings.NotifyOnStart" @bind-Value:after="SaveAsync"
                           Label="@L["settings.notifyStart"]" Color="Color.Primary"/>
            </MudItem>
            <MudItem xs="6" sm="3" Class="d-flex align-center">
                <MudSwitch T="bool" @bind-Value="_settings.NotifyOnComplete" @bind-Value:after="SaveAsync"
                           Label="@L["settings.notifyFinish"]" Color="Color.Primary"/>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="PostDownloadAction" @bind-Value="_settings.PostDownloadAction" @bind-Value:after="SaveAsync"
                           Label="@L["settings.postDownload"]" Variant="Variant.Outlined"
                           HelperText="@PostDownloadHelp">
                    <MudSelectItem Value="PostDownloadAction.StopSeeding">@L["settings.stopSeeding"]</MudSelectItem>
                    <MudSelectItem Value="PostDownloadAction.KeepSeeding">@L["settings.keepSeeding"]</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-6 mb-4">
        <div class="d-flex align-center gap-3 mb-2">
            <MudIcon Icon="@Icons.Material.Rounded.SmartToy" Color="Color.Primary"/>
            <MudText Typo="Typo.h6">@L["settings.agentAccess"]</MudText>
            <MudSpacer/>
            <MudSwitch T="bool" Value="_settings.AgentApiEnabled" ValueChanged="ToggleAgentApiAsync"
                       Color="Color.Primary"/>
        </div>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@L["settings.agentHint"]</MudText>

        @if (_settings.AgentApiEnabled)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                @L["settings.agentLoopbackHint"]
            </MudAlert>
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudSwitch T="bool" Value="_settings.AgentApiAllowRemote" ValueChanged="ToggleAgentRemoteAsync"
                               Label="@L["settings.agentRemote"]" Color="Color.Warning"/>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                        @L["settings.agentRemoteHint"]
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="9">
                    <MudTextField T="string" Value="@_settings.AgentApiToken" ReadOnly="true"
                                  Label="@L["settings.agentToken"]" Variant="Variant.Outlined"
                                  InputType="@(_showAgentToken ? InputType.Text : InputType.Password)"/>
                </MudItem>
                <MudItem xs="12" sm="3" Class="d-flex align-center gap-2">
                    <MudTooltip Text="@L["settings.agentReveal"]">
                        <MudIconButton Icon="@(_showAgentToken ? Icons.Material.Rounded.VisibilityOff : Icons.Material.Rounded.Visibility)"
                                       OnClick="@(() => _showAgentToken = !_showAgentToken)"/>
                    </MudTooltip>
                    <MudTooltip Text="@L["settings.agentCopy"]">
                        <MudIconButton Icon="@Icons.Material.Rounded.ContentCopy"
                                       OnClick="@(() => CopyAsync(_settings.AgentApiToken))"/>
                    </MudTooltip>
                    <MudTooltip Text="@L["settings.agentRegenerate"]">
                        <MudIconButton Icon="@Icons.Material.Rounded.Refresh" Color="Color.Warning"
                                       OnClick="RegenerateAgentTokenAsync"/>
                    </MudTooltip>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Value="@AgentEndpoint.McpUrl" ReadOnly="true"
                                  Label="@L["settings.agentMcpUrl"]" Variant="Variant.Outlined"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Rounded.ContentCopy"
                                  OnAdornmentClick="@(() => CopyAsync(AgentEndpoint.McpUrl))"/>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Value="@ClaudeMcpCommand" ReadOnly="true"
                                  Label="@L["settings.agentClaudeCommand"]" Variant="Variant.Outlined"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Rounded.ContentCopy"
                                  OnAdornmentClick="@(() => CopyAsync(ClaudeMcpCommand))"/>
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @L.Format("settings.agentEndpointFile", AppPaths.AgentEndpointPath)
                    </MudText>
                </MudItem>
            </MudGrid>
        }
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-6 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Rounded.Dns" Color="Color.Primary"/>
            <MudText Typo="Typo.h6">@L["settings.sources"]</MudText>
        </MudStack>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@L["settings.sourcesHint"]</MudText>
        <MudStack Spacing="3">
            @foreach (var provider in SearchService.Providers)
            {
                var providerName = provider.Name;
                <div>
                    <MudSwitch T="bool" Color="Color.Primary"
                               Value="_settings.IsProviderEnabled(providerName)"
                               ValueChanged="@(v => ToggleProviderAsync(providerName, v))"
                               Label="@providerName"/>
                    @if (provider.RequiresCredentials)
                    {
                        var cred = GetCredential(providerName);
                        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-1 d-block">@L["settings.credentialsHint"]</MudText>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="cred.Username" @bind-Value:after="@(() => SaveCredentialAsync(cred))"
                                              Label="@L["settings.username"]" Variant="Variant.Outlined" Margin="Margin.Dense"/>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="cred.Password" @bind-Value:after="@(() => SaveCredentialAsync(cred))"
                                              Label="@L["settings.password"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                              InputType="InputType.Password"/>
                            </MudItem>
                        </MudGrid>
                    }
                </div>
            }
        </MudStack>
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-6 mb-4">
        <div class="d-flex align-center gap-3 mb-3">
            <MudIcon Icon="@Icons.Material.Rounded.NotificationsActive" Color="Color.Primary"/>
            <MudText Typo="Typo.h6">@L["settings.desktop"]</MudText>
            <MudSpacer/>
            <MudSwitch T="bool" @bind-Value="_settings.DesktopEnabled" @bind-Value:after="SaveAsync" Color="Color.Primary"/>
        </div>
        <MudText Typo="Typo.body2" class="mud-text-secondary">@L["settings.desktopHint"]</MudText>
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-6 mb-4">
        <div class="d-flex align-center gap-3 mb-3">
            <MudIcon Icon="@Icons.Material.Rounded.MailOutline" Color="Color.Primary"/>
            <MudText Typo="Typo.h6">@L["settings.email"]</MudText>
            <MudSpacer/>
            <MudSwitch T="bool" @bind-Value="_settings.EmailEnabled" @bind-Value:after="SaveAsync" Color="Color.Primary"/>
        </div>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="5">
                <MudTextField @bind-Value="_settings.SmtpHost" @bind-Value:after="SaveAsync"
                              Label="@L["settings.smtpHost"]" Variant="Variant.Outlined"/>
            </MudItem>
            <MudItem xs="6" sm="2">
                <MudNumericField T="int" @bind-Value="_settings.SmtpPort" @bind-Value:after="SaveAsync"
                                 Label="@L["settings.port"]" Variant="Variant.Outlined" Min="1" Max="65535"/>
            </MudItem>
            <MudItem xs="6" sm="2" Class="d-flex align-center">
                <MudSwitch T="bool" @bind-Value="_settings.SmtpUseSsl" @bind-Value:after="SaveAsync"
                           Label="@L["settings.ssl"]" Color="Color.Primary"/>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="_settings.SmtpUsername" @bind-Value:after="SaveAsync"
                              Label="@L["settings.username"]" Variant="Variant.Outlined"/>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_settings.SmtpPassword" @bind-Value:after="SaveAsync"
                              Label="@L["settings.password"]" Variant="Variant.Outlined" InputType="InputType.Password"/>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_settings.EmailFrom" @bind-Value:after="SaveAsync"
                              Label="@L["settings.from"]" Variant="Variant.Outlined"/>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_settings.EmailTo" @bind-Value:after="SaveAsync"
                              Label="@L["settings.to"]" Variant="Variant.Outlined"/>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-6 mb-4">
        <div class="d-flex align-center gap-3 mb-3">
            <MudIcon Icon="@Icons.Material.Rounded.PhoneIphone" Color="Color.Primary"/>
            <MudText Typo="Typo.h6">@L["settings.push"]</MudText>
            <MudSpacer/>
            <MudSwitch T="bool" @bind-Value="_settings.PushEnabled" @bind-Value:after="SaveAsync" Color="Color.Primary"/>
        </div>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_settings.NtfyServer" @bind-Value:after="SaveAsync"
                              Label="@L["settings.ntfyServer"]" Variant="Variant.Outlined"/>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_settings.NtfyTopic" @bind-Value:after="SaveAsync"
                              Label="@L["settings.topic"]" Variant="Variant.Outlined"
                              HelperText="@L["settings.topicHint"]"/>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-6 mb-4">
        <div class="d-flex align-center gap-3 mb-3">
            <MudIcon Icon="@Icons.Material.Rounded.Send" Color="Color.Primary"/>
            <MudText Typo="Typo.h6">@L["settings.telegram"]</MudText>
            <MudSpacer/>
            <MudSwitch T="bool" @bind-Value="_settings.TelegramEnabled" @bind-Value:after="SaveAsync" Color="Color.Primary"/>
        </div>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_settings.TelegramBotToken" @bind-Value:after="SaveAsync"
                              Label="@L["settings.botToken"]" Variant="Variant.Outlined" InputType="InputType.Password"
                              HelperText="@L["settings.botTokenHint"]"/>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_settings.TelegramChatId" @bind-Value:after="SaveAsync"
                              Label="@L["settings.chatId"]" Variant="Variant.Outlined"
                              HelperText="@L["settings.chatIdHint"]"/>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
               StartIcon="@Icons.Material.Rounded.NotificationsActive"
               Disabled="_testing" OnClick="SendTestAsync">
        @L["settings.sendTest"]
    </MudButton>

    <MudPaper Outlined="true" Class="pa-6 mt-4 mb-4">
        <div class="d-flex align-center gap-3 mb-3">
            <MudIcon Icon="@Icons.Material.Rounded.SystemUpdateAlt" Color="Color.Primary"/>
            <MudText Typo="Typo.h6">@L["settings.about"]</MudText>
            <MudSpacer/>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@L.Format("settings.version", UpdateService.CurrentVersionText)</MudText>
        </div>
        @if (Updates.Available is { } update)
        {
            <MudAlert Severity="Severity.Info" Class="mb-3">
                @L.Format("settings.updateAvailable", update.TagName)
                <MudLink Href="@update.ReleaseUrl" Target="_blank">@L["settings.releaseNotes"]</MudLink>
            </MudAlert>
        }
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Rounded.Refresh"
                       Disabled="Updates.Checking" OnClick="CheckForUpdatesAsync">
                @(Updates.Checking ? L["settings.checking"] : L["settings.checkUpdates"])
            </MudButton>
            @if (Updates.Available is not null)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                           StartIcon="@Icons.Material.Rounded.SystemUpdateAlt"
                           Disabled="Updates.Installing" OnClick="InstallUpdateAsync">
                    @(Updates.Installing ? L["settings.installing"]
                        : Updates.CanSelfInstall ? L.Format("settings.install", Updates.Available.TagName)
                        : L["settings.openRelease"])
                </MudButton>
            }
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@UpdateStatusText</MudText>
        </MudStack>
    </MudPaper>
}

@code {
    private AppSettings? _settings;
    private List<ProviderCredential> _credentials = new();
    private bool _testing;
    private bool _showAgentToken;

    private string ClaudeMcpCommand =>
        $"claude mcp add --transport http mediadownloader {AgentEndpoint.McpUrl}";

    private string PostDownloadHelp => _settings?.PostDownloadAction switch
    {
        PostDownloadAction.KeepSeeding => L["settings.keepSeedingHelp"],
        _ => L["settings.stopSeedingHelp"]
    };

    private string UpdateStatusText =>
        Updates.Checking ? L["settings.checking"]
        : Updates.LastCheckError is { } err ? L.Format("settings.lastCheckFailed", err)
        : Updates.Available is not null ? ""
        : Updates.LastCheckedAt is { } at ? L.Format("settings.checkedAt", at.ToString("HH:mm"))
        : L["settings.checkAuto"];

    protected override async Task OnInitializedAsync()
    {
        Updates.StateChanged += OnUpdateStateChanged;
        _settings = await SettingsService.GetAsync();
        _credentials = await SettingsService.GetCredentialsAsync();
    }

    private void OnUpdateStateChanged() => _ = InvokeAsync(StateHasChanged);

    protected override void Dispose(bool disposing)
    {
        if (disposing)
            Updates.StateChanged -= OnUpdateStateChanged;
        base.Dispose(disposing);
    }

    /// <summary>Finds or creates the in-memory credential row for a provider (persisted on edit).</summary>
    private ProviderCredential GetCredential(string providerName)
    {
        var cred = _credentials.FirstOrDefault(c => c.ProviderName == providerName);
        if (cred is null)
        {
            cred = new ProviderCredential { ProviderName = providerName };
            _credentials.Add(cred);
        }
        return cred;
    }

    private async Task ChangeLanguageAsync(string code)
    {
        if (_settings is null) return;
        _settings.Language = code;
        await SaveAsync();
        L.SetLanguage(code);
    }

    private async Task CheckForUpdatesAsync()
    {
        var update = await Updates.CheckNowAsync();
        if (update is not null)
            Snackbar.Add(L.Format("settings.updateSnack", update.TagName), Severity.Info);
        else if (Updates.LastCheckError is { } err)
            Snackbar.Add(L.Format("settings.lastCheckFailed", err), Severity.Error);
        else
            Snackbar.Add(L.Format("settings.upToDate", UpdateService.CurrentVersionText), Severity.Success);
    }

    private async Task InstallUpdateAsync()
    {
        if (Updates.CanSelfInstall)
            Snackbar.Add(L["settings.installNote"], Severity.Info);
        await Updates.InstallAsync();
    }

    private async Task SaveAsync()
    {
        if (_settings is null) return;
        try
        {
            await SettingsService.SaveAsync(_settings);
            AgentAccess.Invalidate();
        }
        catch (ValidationException ex)
        {
            Snackbar.Add(L.Format("settings.saveFailed", ex.Message), Severity.Error);
        }
    }

    private async Task ToggleAgentApiAsync(bool enabled)
    {
        if (_settings is null) return;
        _settings.AgentApiEnabled = enabled;
        if (enabled && string.IsNullOrEmpty(_settings.AgentApiToken))
            _settings.AgentApiToken = await AgentAccess.EnsureTokenAsync();
        await SaveAsync();
    }

    private async Task ToggleAgentRemoteAsync(bool enabled)
    {
        if (_settings is null) return;
        _settings.AgentApiAllowRemote = enabled;
        await SaveAsync();
        Snackbar.Add(L["settings.agentRestart"], Severity.Info);
    }

    private async Task RegenerateAgentTokenAsync()
    {
        if (_settings is null) return;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["settings.agentRegenerateConfirmTitle"],
            L["settings.agentRegenerateConfirm"],
            yesText: L["settings.agentRegenerate"], cancelText: L["common.cancel"]);
        if (confirmed != true)
            return;

        _settings.AgentApiToken = await AgentAccess.EnsureTokenAsync(regenerate: true);
        AgentEndpoint.UpdateToken(_settings.AgentApiToken);
        Snackbar.Add(L["settings.agentRegenerated"], Severity.Success);
    }

    private async Task CopyAsync(string value)
    {
        await JS.InvokeVoidAsync("mediaDownloader.copyText", value);
        Snackbar.Add(L["settings.agentCopied"], Severity.Success);
    }

    private async Task ToggleProviderAsync(string name, bool enabled)
    {
        if (_settings is null) return;
        _settings.SetProviderEnabled(name, enabled);
        await SaveAsync();
    }

    private async Task SaveCredentialAsync(ProviderCredential cred) => await SettingsService.SaveCredentialAsync(cred);

    private async Task SendTestAsync()
    {
        _testing = true;
        try
        {
            await Notifications.DispatchAsync(new NotificationEvent(
                NotificationKind.DownloadStarted, "Test notification",
                "If you can read this, notifications are working."));
            Snackbar.Add(L["settings.testSent"], Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(L.Format("settings.testFailed", ex.Message), Severity.Error);
        }
        finally
        {
            _testing = false;
        }
    }
}
